<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Munish Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { font-size: .9rem; background: #f5f6fa; }
    .sidebar { background: #1e1e2d; min-height: 100vh; color: #fff; }
    .sidebar .nav-link { color: #a2a3b7; padding: .7rem 1rem; border-radius: 6px; margin: 2px 8px; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: #2a2a3d; }
    .sidebar .nav-link i { margin-right: 8px; width: 20px; text-align: center; }
    .sidebar .brand { padding: 1.2rem 1rem; font-size: 1.2rem; font-weight: 700; border-bottom: 1px solid #2a2a3d; }
    .stat-card { border: none; border-radius: 10px; transition: transform .15s; }
    .stat-card:hover { transform: translateY(-2px); }
    .table th { font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .5px; color: #6c757d; }
    .product-img { width: 40px; height: 40px; object-fit: cover; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <% if (typeof user !== 'undefined' && user) { %>
      <div class="col-md-2 sidebar d-none d-md-block p-0">
        <div class="brand">Munish Admin</div>
        <nav class="nav flex-column mt-2">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-speedometer2"></i> Dashboard</a>
          <a class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/products') ? 'active' : '' %>" href="/products"><i class="bi bi-box"></i> Productos</a>
          <a class="nav-link <%= typeof path !== 'undefined' && path.startsWith('/orders') ? 'active' : '' %>" href="/orders"><i class="bi bi-cart"></i> Pedidos</a>
          <a class="nav-link" href="/export/products" target="_blank"><i class="bi bi-download"></i> Exportar JSON</a>
          <hr style="border-color: #2a2a3d;">
          <a class="nav-link" href="/logout"><i class="bi bi-box-arrow-left"></i> Salir</a>
        </nav>
      </div>
      <% } %>
      <div class="<%= typeof user !== 'undefined' && user ? 'col-md-10' : 'col-12' %> p-4">
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="d-flex justify-content-between align-items-center mb-4 d-md-none">
          <strong>Munish Admin</strong>
          <div>
            <a href="/products" class="btn btn-sm btn-outline-secondary me-1">Productos</a>
            <a href="/orders" class="btn btn-sm btn-outline-secondary me-1">Pedidos</a>
            <a href="/logout" class="btn btn-sm btn-outline-danger">Salir</a>
          </div>
        </div>
        <% } %>
        <%- body %>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
